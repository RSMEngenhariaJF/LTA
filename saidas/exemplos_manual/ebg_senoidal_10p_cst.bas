' Macro CST gerada por LTA (linhas periodicas) - estrutura 'ebg_senoidal_10p'
' Executar em Home > Macros > Edit/Run VBA Macro (ou colar no History List).
' Unidades: mm / GHz. Cobre modelado como PEC com espessura t.
Sub Main ()
With Units
    .Geometry "mm"
    .Frequency "GHz"
    .Time "ns"
End With
StoreDoubleParameter "h", 1.27
StoreDoubleParameter "t", 0.035
StoreDoubleParameter "er", 10.2
StoreDoubleParameter "tand", 0.0022
RebuildOnParametricChange False, False

With Material
    .Reset
    .Name "substrato_lta"
    .Folder ""
    .FrqType "all"
    .Type "Normal"
    .Epsilon "er"
    .Mu "1"
    .TanD "tand"
    .TanDFreq "5.25"
    .TanDGiven "True"
    .TanDModel "ConstTanD"
    .Colour "0.5", "0.8", "0.5"
    .Create
End With

With Brick
    .Reset : .Name "Substrato" : .Component "lta" : .Material "substrato_lta"
    .Xrange "0", "110" : .Yrange "-7.599562", "7.599562" : .Zrange "0", "h"
    .Create
End With
With Brick
    .Reset : .Name "Terra" : .Component "lta" : .Material "PEC"
    .Xrange "0", "110" : .Yrange "-7.599562", "7.599562" : .Zrange "-t", "0"
    .Create
End With

